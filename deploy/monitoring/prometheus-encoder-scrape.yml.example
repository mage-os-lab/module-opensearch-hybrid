scrape_configs:
  - job_name: mageos-opensearch-hybrid-encoder
    scrape_interval: 15s
    scrape_timeout: 5s
    metrics_path: /metrics
    scheme: http
    follow_redirects: false
    authorization:
      type: Bearer
      credentials_file: /run/secrets/encoder_metrics_token
    static_configs:
      - targets:
          - 127.0.0.1:18080
