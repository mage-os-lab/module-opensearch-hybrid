<?xml version="1.0"?>
<ruleset name="Mage-OS OpenSearch Hybrid">
    <description>Magento runtime coding-standard gate for MageOS_OpenSearchHybrid.</description>

    <arg name="extensions" value="php,phtml,xml,graphql,css,js"/>
    <arg name="warning-severity" value="0"/>

    <exclude-pattern>*/dev/*</exclude-pattern>
    <rule ref="Magento2"/>
</ruleset>
