<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/consumer.xsd">
    <consumer name="mageos.opensearch_hybrid.embedding.consumer"
              queue="mageos.opensearch_hybrid.embedding"
              connection="amqp"
              consumerInstance="Magento\Framework\MessageQueue\Consumer"
              handler="MageOS\OpenSearchHybrid\Model\Queue\EmbeddingConsumer::process"
              maxMessages="100"/>
    <consumer name="mageos.opensearch_hybrid.correctness.consumer"
              queue="mageos.opensearch_hybrid.correctness_priority"
              connection="amqp"
              consumerInstance="Magento\Framework\MessageQueue\Consumer"
              handler="MageOS\OpenSearchHybrid\Model\Queue\PriorityConsumer::process"
              maxMessages="1000"/>
</config>
